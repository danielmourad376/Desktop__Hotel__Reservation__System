<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.ManageRoomTypesController">
    <VBox spacing="15.0" style="-fx-padding: 20;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Label styleClass="content-welcome-title" text="Manage Room Types" />
        <Label styleClass="content-welcome-subtitle" text="Create, update, or remove room categories." />

        <TableView fx:id="roomTypesTable" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" prefWidth="150.0" text="Type Name" />
                <TableColumn fx:id="colPrice" prefWidth="120.0" text="Base Price" />
                <TableColumn fx:id="colMaxOcc" prefWidth="120.0" text="Max Occupancy" />
                <TableColumn fx:id="colDesc" prefWidth="250.0" text="Description" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #B0B8C8; -fx-border-radius: 8;">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Room Type Details" />

            <HBox spacing="10">
                <TextField fx:id="nameField" promptText="Name" styleClass="text-field" prefHeight="32.0" prefWidth="150" />
                <TextField fx:id="priceField" promptText="Price" styleClass="text-field" prefHeight="32.0" prefWidth="100" />
                <TextField fx:id="occField" promptText="Max Occ." styleClass="text-field" prefHeight="32.0" prefWidth="100" />
                <TextField fx:id="descField" promptText="Description..." styleClass="text-field" prefHeight="32.0" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#handleClear" styleClass="secondary-button" text="Clear Form" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="deleteBtn" disable="true" onAction="#handleDelete" styleClass="primary-red-button" text="Delete Selected" />
                <Button fx:id="updateBtn" disable="true" onAction="#handleUpdate" styleClass="secondary-button" text="Update Selected" />
                <Button onAction="#handleAdd" style="-fx-border-color: #2c3e50; -fx-text-fill: #2c3e50;" styleClass="secondary-button" text="Add New Type" />
            </HBox>
        </VBox>

    </VBox>
</AnchorPane>