<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.ManageWalletController">
    <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 30;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Label styleClass="content-welcome-title" text="Manage Wallet" />
        <Label styleClass="content-welcome-subtitle" text="Add funds to your PrimeStay account." />

        <VBox alignment="CENTER" maxWidth="350.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

            <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-family: 'Times New Roman';" text="Current Balance" />
            <Label fx:id="currentBalanceLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-family: 'Times New Roman';" text="\$0.00" />

            <Label style="-fx-font-size: 20px;" text=" " /> <Label style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Times New Roman';" text="Amount to Add ($):" />
            <TextField fx:id="amountField" alignment="CENTER" promptText="e.g. 50.00" styleClass="text-field" />

            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleAddFunds" prefHeight="40.0" prefWidth="200.0" style="-fx-translate-y: 15;" styleClass="primary-red-button" text="Add Funds" />

        </VBox>
    </VBox>
</AnchorPane>
