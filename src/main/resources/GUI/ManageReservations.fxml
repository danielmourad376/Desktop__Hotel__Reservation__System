<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.ManageReservationsController">
    <VBox spacing="15.0" style="-fx-padding: 20;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Label styleClass="content-welcome-title" text="Manage Reservations" />
        <Label styleClass="content-welcome-subtitle" text="View all bookings, confirm pending requests, and manage guest check-ins." />

        <TableView fx:id="allReservationsTable" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colResId" prefWidth="100.0" text="Res. ID" />
                <TableColumn fx:id="colGuest" prefWidth="120.0" text="Guest Username" />
                <TableColumn fx:id="colRoomNum" prefWidth="90.0" text="Room No." />
                <TableColumn fx:id="colCheckIn" prefWidth="110.0" text="Check-In" />
                <TableColumn fx:id="colCheckOut" prefWidth="110.0" text="Check-Out" />
                <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button fx:id="confirmBtn" mnemonicParsing="false" onAction="#handleConfirm" styleClass="secondary-button" text="Confirm Pending" />
            <Button fx:id="checkInBtn" mnemonicParsing="false" onAction="#handleCheckIn" styleClass="secondary-button" text="Check-In Guest" />

            <Button fx:id="checkOutBtn" mnemonicParsing="false" onAction="#handleCheckOut" styleClass="primary-red-button" text="Check-Out Guest" />
        </HBox>

    </VBox>
</AnchorPane>