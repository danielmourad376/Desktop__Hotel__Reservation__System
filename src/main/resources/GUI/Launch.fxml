<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.LaunchController">
        <Label styleClass="title" text="PrimeStay Hotel" textFill="WHITE">
            <font>
                <Font name="Times New Roman Bold" size="36.0" />
            </font>
        </Label>

        <Label styleClass="subtitle" text="Where Comfort Meets Excellence">
            <VBox.margin>
                <Insets bottom="40.0" top="5.0" />
            </VBox.margin>
         <font>
            <Font name="Times New Roman Italic" size="12.0" />
         </font>
        </Label>

        <Label prefHeight="0.0" style="-fx-border-color: transparent; -fx-border-width: 0 0 2 0; -fx-pref-width: 300;" text=" ">
         <VBox.margin>
            <Insets bottom="40.0" top="30.0" />
         </VBox.margin></Label>

        <Label style="-fx-text-fill: #B0B8C8; -fx-font-size: 18; " text="Please log in or create a new account to continue.">
            <VBox.margin>
                <Insets bottom="40.0" top="40.0" />
            </VBox.margin>
         <font>
            <Font name="Times New Roman" size="12.0" />
         </font>
        </Label>

        <Button mnemonicParsing="false" onAction="#handleLoginClick" prefHeight="45.0" prefWidth="225.0" styleClass="primary-red-button" text="Log In to Existing Account">
            <VBox.margin>
                <Insets bottom="15.0" />
            </VBox.margin>
        </Button>

        <Button mnemonicParsing="false" onAction="#handleRegisterClick" prefHeight="45.0" prefWidth="225.0" styleClass="primary-red-button" text="Register New Guest" />
</VBox>
